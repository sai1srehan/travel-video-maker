# Copy this file to .env and fill in your keys.

# Gemini (writes the script) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model
# GEMINI_MODEL=gemini-2.5-flash

# Free stock footage (at least one of these is required)
# https://www.pexels.com/api/
PEXELS_API_KEY=
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Optional: YouTube Data API v3 key, used ONLY to find Creative Commons (CC BY) videos
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
